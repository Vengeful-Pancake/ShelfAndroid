<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A deterministic, test-APK-only SAF provider with opaque document IDs. -->
        <provider android:name="com.shelf.reader.FolderFixtureProvider"
            android:authorities="com.shelf.reader.test.folders"
            android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
    </application>
</manifest>
